  "audio_segments": [
    {
      "scene_id": 1,
      "segment_id": "title",
      "speaker": "旁白",
      "type": "narrator",
      "text": "什么都不怕的爸爸",
      "dialogue": "",
      "start": 0.0,
      "duration": 2.468,
      "visual_duration": 3.268,
      "title": true
    },
    {
      "scene_id": 2,
      "segment_id": "seg_00000_e6382a17",
      "speaker": "旁白",
      "type": "narrator",
      "text": "星期天下午，牛牛和爸爸、姐姐添添在客厅搭积木。爸爸搭了一座好高好高的城堡，拍拍胸脯说：",
      "dialogue": "",
      "start": 3.268,
      "duration": 11.0096,
      "visual_duration": 11.3096,
      "title": false
    },
    {
      "scene_id": 3,
      "segment_id": "seg_00044_f50f9bee",
      "speaker": "爸爸",
      "type": "dialogue",
      "text": "爸爸什么都不怕！",
      "dialogue": "爸爸什么都不怕！",
      "start": 14.5776,
      "duration": 1.1583,
      "visual_duration": 1.4583,
      "title": false
    },
    {
      "scene_id": 4,
      "segment_id": "seg_00053_2d97d933",
      "speaker": "旁白",
      "type": "narrator",
      "text": "忽然，添添指着地板喊：",
      "dialogue": "",
      "start": 16.0359,
      "duration": 3.216,
      "visual_duration": 3.516,
      "title": false
    },
    {
      "scene_id": 5,
      "segment_id": "seg_00067_22c10919",
      "speaker": "添添",
      "type": "dialogue",
      "text": "爸爸，有虫子！",
      "dialogue": "爸爸，有虫子！",
      "start": 19.5519,
      "duration": 1.3721,
      "visual_duration": 1.6721,
      "title": false
    },
    {
      "scene_id": 6,
      "segment_id": "seg_00075_2528909c",
      "speaker": "旁白",
      "type": "narrator",
      "text": "一只黑黑的小甲虫，正慢悠悠地爬过来。",
      "dialogue": "",
      "start": 21.224,
      "duration": 4.4115,
      "visual_duration": 4.7115,
      "title": false
    },
    {
      "scene_id": 7,
      "segment_id": "seg_00095_5c285d91",
      "speaker": "旁白",
      "type": "narrator",
      "text": "爸爸惊叫一声，跳上沙发",
      "dialogue": "",
      "start": 25.9355,
      "duration": 2.9527,
      "visual_duration": 3.2527,
      "title": false
    },
    {
      "scene_id": 8,
      "segment_id": "seg_00100_9dda7f02",
      "speaker": "旁白",
      "type": "narrator",
      "text": "地跳上沙发，大叫：",
      "dialogue": "",
      "start": 29.1883,
      "duration": 2.832,
      "visual_duration": 3.132,
      "title": false
    },
    {
      "scene_id": 9,
      "segment_id": "seg_00110_6cba8cb9",
      "speaker": "爸爸",
      "type": "dialogue",
      "text": "快！快把它弄走！",
      "dialogue": "快！快把它弄走！",
      "start": 32.3203,
      "duration": 1.664,
      "visual_duration": 1.964,
      "title": false
    },
    {
      "scene_id": 10,
      "segment_id": "seg_00119_078127af",
      "speaker": "旁白",
      "type": "narrator",
      "text": "牛牛瞪大眼睛，简直不敢相信。平时讲故事连大灰狼都不怕的爸爸，居然怕一只小虫子！牛牛鼓起勇气，抽出一张纸巾说：",
      "dialogue": "",
      "start": 34.2843,
      "duration": 13.8708,
      "visual_duration": 14.1708,
      "title": false
    },
    {
      "scene_id": 11,
      "segment_id": "seg_00178_ba54c991",
      "speaker": "牛牛",
      "type": "dialogue",
      "text": "爸爸别怕，牛牛保护你！",
      "dialogue": "爸爸别怕，牛牛保护你！",
      "start": 48.4551,
      "duration": 2.3766,
      "visual_duration": 2.6766,
      "title": false
    },
    {
      "scene_id": 12,
      "segment_id": "seg_00189_d450faef",
      "speaker": "旁白",
      "type": "narrator",
      "text": "小甲虫忽然张开翅膀，嗡地飞了起来",
      "dialogue": "",
      "start": 51.1317,
      "duration": 4.7837,
      "visual_duration": 5.0837,
      "title": false
    },
    {
      "scene_id": 13,
      "segment_id": "seg_00216_b69ae1b8",
      "speaker": "旁白",
      "type": "narrator",
      "text": "地飞了起来。牛牛吓得一屁股坐到地上，喊：",
      "dialogue": "",
      "start": 56.2154,
      "duration": 5.1696,
      "visual_duration": 5.4696,
      "title": false
    },
    {
      "scene_id": 14,
      "segment_id": "seg_00237_07bba7df",
      "speaker": "牛牛",
      "type": "dialogue",
      "text": "它还会飞！",
      "dialogue": "它还会飞！",
      "start": 61.685,
      "duration": 1.1668,
      "visual_duration": 1.4668,
      "title": false
    },
    {
      "scene_id": 15,
      "segment_id": "seg_00243_ddd5db74",
      "speaker": "旁白",
      "type": "narrator",
      "text": "小甲虫绕着客厅飞了一圈，居然朝沙发飞去。爸爸抱着靠垫直往后缩，喊：",
      "dialogue": "",
      "start": 63.1518,
      "duration": 9.2395,
      "visual_duration": 9.5395,
      "title": false
    },
    {
      "scene_id": 16,
      "segment_id": "seg_00279_c5bbf5a7",
      "speaker": "爸爸",
      "type": "dialogue",
      "text": "别过来！别过来！",
      "dialogue": "别过来！别过来！",
      "start": 72.6913,
      "duration": 1.3368,
      "visual_duration": 1.6368,
      "title": false
    },
    {
      "scene_id": 17,
      "segment_id": "seg_00290_90ebb772",
      "speaker": "旁白",
      "type": "narrator",
      "text": "添添看准机会，啪地扣住甲虫",
      "dialogue": "",
      "start": 74.3281,
      "duration": 3.936,
      "visual_duration": 4.236,
      "title": false
    },
    {
      "scene_id": 18,
      "segment_id": "seg_00308_fa21126c",
      "speaker": "旁白",
      "type": "narrator",
      "text": "地扣住甲虫，得意地说：",
      "dialogue": "",
      "start": 78.5641,
      "duration": 2.832,
      "visual_duration": 3.132,
      "title": false
    },
    {
      "scene_id": 19,
      "segment_id": "seg_00320_18a33921",
      "speaker": "添添",
      "type": "dialogue",
      "text": "这有什么好怕的！",
      "dialogue": "这有什么好怕的！",
      "start": 81.6961,
      "duration": 1.3631,
      "visual_duration": 1.6631,
      "title": false
    },
    {
      "scene_id": 20,
      "segment_id": "seg_00329_3aacd7ee",
      "speaker": "旁白",
      "type": "narrator",
      "text": "她把甲虫送到阳台外面，拍拍手说：",
      "dialogue": "",
      "start": 83.3593,
      "duration": 4.3793,
      "visual_duration": 4.6793,
      "title": false
    },
    {
      "scene_id": 21,
      "segment_id": "seg_00346_af778075",
      "speaker": "添添",
      "type": "dialogue",
      "text": "好啦，飞走喽！",
      "dialogue": "好啦，飞走喽！",
      "start": 88.0386,
      "duration": 1.634,
      "visual_duration": 1.934,
      "title": false
    },
    {
      "scene_id": 22,
      "segment_id": "seg_00356_b3d8123b",
      "speaker": "旁白",
      "type": "narrator",
      "text": "爸爸解释说，他站得高是为了帮大家看清楚虫子往哪儿飞",
      "dialogue": "",
      "start": 89.9726,
      "duration": 6.36,
      "visual_duration": 6.66,
      "title": false
    },
    {
      "scene_id": 23,
      "segment_id": "seg_00398_a0ce174f",
      "speaker": "旁白",
      "type": "narrator",
      "text": "牛牛和添添一起喊：",
      "dialogue": "",
      "start": 96.6326,
      "duration": 2.3283,
      "visual_duration": 2.6283,
      "title": false
    },
    {
      "scene_id": 24,
      "segment_id": "seg_00410_0cab4312",
      "speaker": "牛牛",
      "type": "dialogue",
      "text": "爸爸就是害怕！",
      "dialogue": "爸爸就是害怕！",
      "start": 99.2609,
      "duration": 1.498,
      "visual_duration": 1.798,
      "title": false
    },
    {
      "scene_id": 25,
      "segment_id": "seg_00418_351a4d34",
      "speaker": "旁白",
      "type": "narrator",
      "text": "爸爸挠挠头笑了，说：",
      "dialogue": "",
      "start": 101.0589,
      "duration": 2.9482,
      "visual_duration": 3.2482,
      "title": false
    },
    {
      "scene_id": 26,
      "segment_id": "seg_00431_4c197023",
      "speaker": "爸爸",
      "type": "dialogue",
      "text": "好吧，是有那么一点点怕。只有一点点哦！",
      "dialogue": "好吧，是有那么一点点怕。只有一点点哦！",
      "start": 104.3071,
      "duration": 3.9277,
      "visual_duration": 4.2277,
      "title": false
    },
    {
      "scene_id": 27,
      "segment_id": "seg_00451_8c617911",
      "speaker": "旁白",
      "type": "narrator",
      "text": "牛牛学着爸爸的样子拍拍胸脯，说：",
      "dialogue": "",
      "start": 108.5349,
      "duration": 4.6385,
      "visual_duration": 4.9385,
      "title": false
    },
    {
      "scene_id": 28,
      "segment_id": "seg_00470_2ab0ee38",
      "speaker": "牛牛",
      "type": "dialogue",
      "text": "没关系，下次虫子再来，我和添添保护你！",
      "dialogue": "没关系，下次虫子再来，我和添添保护你！",
      "start": 113.4734,
      "duration": 3.8341,
      "visual_duration": 4.1341,
      "title": false
    },
    {
      "scene_id": 29,
      "segment_id": "seg_00490_b8a65ddc",
      "speaker": "旁白",
      "type": "narrator",
      "text": "爸爸一手搂住一个，三个人笑成一团。",
      "dialogue": "",
      "start": 117.6075,
      "duration": 4.8044,
      "visual_duration": 7.8144,
      "title": false
    }
  ],
